# stock-trends 환경변수
#
#   cp .env.local.example .env.local
#
# 이 파일(.env.local)은 **로컬 개발 전용**이고 커밋되지 않습니다.
# 실제 값은 아래 세 곳에 나눠 넣으며, 필요한 값이 각각 다릅니다.
#
#   [L] .env.local          로컬 개발
#   [V] Vercel              Project Settings → Environment Variables
#   [G] GitHub Actions      Settings → Secrets and variables → Actions
#
# ┌────────────────────────────────┬─────┬─────┬─────┐
# │ 변수                            │  L  │  V  │  G  │
# ├────────────────────────────────┼─────┼─────┼─────┤
# │ NEXT_PUBLIC_SITE_URL           │  ·  │  ●  │  ·  │
# │ NEXT_PUBLIC_SUPABASE_URL       │  ●  │  ●  │  ·  │
# │ NEXT_PUBLIC_SUPABASE_ANON_KEY  │  ●  │  ●  │  ·  │
# │ SUPABASE_SERVICE_ROLE_KEY      │  ●  │  ●  │  ·  │
# │ NEXT_PUBLIC_TURNSTILE_SITE_KEY │  ·  │  ●  │  ·  │
# │ TURNSTILE_SECRET_KEY           │  ·  │  ●  │  ·  │
# │ GOOGLE_SITE_VERIFICATION       │  ·  │  ●  │  ·  │
# │ NAVER_SITE_VERIFICATION        │  ·  │  ●  │  ·  │
# │ ECOS_API_KEY                   │  ·  │  ·  │  ●  │
# │ SITE_URL                       │  ·  │  ·  │  ●  │
# └────────────────────────────────┴─────┴─────┴─────┘
#
# 짚어둘 것 두 가지
#
# 1. ECOS_API_KEY는 Vercel에 넣지 않습니다.
#    데이터 수집은 GitHub Actions에서만 돌고, 배포된 앱은 이미 만들어진 JSON만 읽습니다.
#
# 2. NEXT_PUBLIC_* 는 빌드 타임에 번들로 인라인됩니다.
#    Vercel에서 값을 바꾸면 재배포해야 반영됩니다. 런타임에 읽히지 않습니다.
#
# 지금 단계(비교 페이지)는 **아무 값도 없어도 동작합니다.**
# 시세·환율이 저장소 안의 정적 JSON이고 조회 시점에 외부 API를 부르지 않기 때문입니다.


# ─────────────────────────────────────────────────────────────
# 사이트                                                    [V]
# ─────────────────────────────────────────────────────────────

# canonical URL·OG 이미지·sitemap의 절대 경로 기준.
# path 없이 origin만 넣으세요. 없으면 https://stock-trends.vercel.app 로 폴백합니다.
# 로컬에서는 비워두면 됩니다.
NEXT_PUBLIC_SITE_URL=


# ─────────────────────────────────────────────────────────────
# Supabase — 게시판·종목 추가 요청 (Phase 5)          [L] [V]
# ─────────────────────────────────────────────────────────────
# https://supabase.com 프로젝트 생성 → Project Settings → API
#
# 시세 데이터는 Supabase에 넣지 않습니다. 주간 데이터라 DB가 할 일이 없고,
# 조회마다 DB를 때리면 사용자가 늘수록 비용이 늘어 광고 모델이 무너집니다.
# 쓰기가 필요한 것(게시글·요청)에만 씁니다.

# Project URL. 예: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon (public) key.
# RLS를 전면 차단하고 모든 쓰기를 서버 라우트에서 처리하므로 이 키로는 사실상 아무것도 못 합니다.
# 유출돼도 안전하도록 설계한 심층 방어입니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — 절대 클라이언트에 노출하지 마세요. Vercel에서도 Secret으로 넣습니다.
# 서버 라우트에서만 씁니다. IP 해시 레이트리밋·토큰 검증이 서버에서만 가능하기 때문입니다.
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────
# Cloudflare Turnstile — 게시판 스팸 방지 (권장)          [V]
# ─────────────────────────────────────────────────────────────
# https://dash.cloudflare.com → Turnstile → 사이트 추가 (무료)
#
# 주식 게시판은 리딩방·코인·대출 광고 봇의 1순위 표적이라 방명록과 위협 모델이 다릅니다.
# "IP당 30초 제한"만으로는 30초마다 광고가 하나씩 쌓입니다.
# 비워두면 Turnstile 검증을 건너뛰고 나머지 방어선(레이트리밋·금칙어·섀도밴)만 작동합니다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ─────────────────────────────────────────────────────────────
# 검색엔진 등록 (배포 후)                                   [V]
# ─────────────────────────────────────────────────────────────

# Google Search Console → 속성 추가 → HTML 태그 방식의 content 값만
GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 → 사이트 등록 → HTML 태그 방식의 content 값만
# 주식 검색은 국내에서 네이버 비중이 커서 구글만 챙기면 유입의 절반을 버립니다.
NAVER_SITE_VERIFICATION=


# ─────────────────────────────────────────────────────────────
# GitHub Actions 전용 — 주간 데이터 갱신 워크플로          [G]
# ─────────────────────────────────────────────────────────────
# 앱 빌드에는 쓰이지 않으므로 Vercel에는 넣지 않습니다.

# 한국은행 ECOS 인증키 — **불필요합니다.**
# 네이버 환율이 키 없이 2004년부터 제공되고 미국 시세가 2010년부터라 이미 충분합니다.
# 한국 종목의 달러 환산을 2000년까지 지원하려는 경우에만 발급하세요.
# https://ecos.bok.or.kr → 오픈API → 인증키 신청 (무료, 즉시)
#
# 값이 있으면 fetch-fx.mjs가 ECOS를 1차로 쓰고 실패 시 네이버로 자동 폴백합니다.
# 사용한 소스는 meta.json의 sources.fx에 기록되어 화면 각주 문구가 따라 바뀝니다.
ECOS_API_KEY=

# 배포된 사이트 origin. 주간 워크플로 끝에 게시판 API를 한 번 호출해
# Supabase 무료 티어의 7일 무활동 일시정지를 막습니다.
SITE_URL=
