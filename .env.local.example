# cp .env.local.example .env.local
#
# 이 파일은 로컬 개발용입니다. 배포 값은 아래 표시대로 넣으세요.
#   [V] Vercel — Project Settings → Environment Variables
#   [G] GitHub Actions — Settings → Secrets and variables → Actions
#
# NEXT_PUBLIC_* 는 빌드 타임에 번들로 인라인됩니다. Vercel에서 값을 바꾸면 재배포해야 반영됩니다.
# 비교 페이지는 값이 하나도 없어도 동작합니다.


# ── 사이트 ──────────────────────────────────────────
# [V] 없으면 https://stock-trends.vercel.app 로 폴백. origin만 넣습니다.
NEXT_PUBLIC_SITE_URL=


# ── Supabase — 게시판·종목요청 ───────────────────────
# supabase.com → Project Settings → API

# [V]
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [V] Secret. 서버 전용 — 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=


# ── 검색엔진 등록 (배포 후) ──────────────────────────
# HTML 태그 방식의 content 값만 넣습니다.

# [V] Google Search Console
GOOGLE_SITE_VERIFICATION=FkVxpqkKnBQlSm1tgTF-GyQP0GLfhX_z03E6h21lipo

# [V] 네이버 서치어드바이저
NAVER_SITE_VERIFICATION=e75ee82f38cc1c1df24f255230aceb1271b0ecec


# ── GitHub Actions 전용 ─────────────────────────────
# 앱 빌드에는 쓰이지 않으므로 Vercel에는 넣지 않습니다.

# [G] 한국은행 ECOS 인증키 (선택). 없어도 네이버로 2004년부터 수집됩니다.
#     한국 종목의 달러 환산을 2000년까지 지원할 때만 필요합니다.
ECOS_API_KEY=

# [G] 배포된 사이트 origin. 주간 워크플로가 Supabase 슬립 방지 핑에 씁니다.
SITE_URL=
